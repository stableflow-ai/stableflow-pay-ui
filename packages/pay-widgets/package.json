{
  "name": "@stableflow/pay-widgets",
  "version": "0.0.1",
  "description": "Business widgets for Stableflow Pay. Data comes in through props and callbacks.",
  "keywords": [
    "stableflow",
    "react",
    "widgets",
    "token-select",
    "payments",
    "tailwindcss"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
